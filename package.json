{
  "name": "aloha_auto",
  "version": "1.0.0",
  "description": "Playwright UI automation cho OrangeHRM Demo (Page Object Model)",
  "main": "index.js",
  "scripts": {
    "test": "PAUSE=0 playwright test --project=chromium",
    "test:all": "PAUSE=0 playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:slow": "SLOWMO=500 playwright test --project=chromium --headed --workers=1",
    "test:login": "playwright test tests/auth --project=chromium --headed",
    "test:admin": "playwright test tests/admin --project=chromium --headed",
    "test:candidates": "playwright test tests/recruitment/candidates.spec.js --project=chromium --headed",
    "test:vacancies": "playwright test tests/recruitment/vacancies.spec.js --project=chromium --headed",
    "test:recruitment": "playwright test tests/recruitment --project=chromium --headed",
    "test:e2e": "playwright test tests/e2e --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "PAUSE=0 playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "orangehrm",
    "pom"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0"
  }
}
